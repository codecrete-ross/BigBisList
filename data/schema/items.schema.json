{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Big BiS List items",
  "type": "object",
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "quality",
          "binding",
          "boe",
          "wowhead_url",
          "sources",
          "primary_source",
          "source_summary",
          "acquisition_phase"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "quality": {
            "type": "string"
          },
          "binding": {
            "type": "string",
            "enum": [
              "bind_on_equip",
              "bind_on_pickup",
              "bind_on_use",
              "quest",
              "unknown"
            ]
          },
          "boe": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "wowhead_url": {
            "type": "string"
          },
          "acquisition_phase": {
            "type": "string",
            "enum": [
              "PR",
              "T4",
              "T5",
              "T6",
              "ZA",
              "SWP"
            ]
          },
          "source_summary": {
            "type": "string"
          },
          "primary_source": {
            "$ref": "#/$defs/source"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/source"
            }
          },
          "tradeable": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$defs": {
    "foreverEvidence": {
      "type": "object",
      "required": ["reviewer", "reviewed_at", "reason", "source_url", "client_build"],
      "properties": {
        "reviewer": { "type": "string", "minLength": 1 },
        "reviewed_at": { "type": "string", "format": "date" },
        "reason": { "type": "string", "minLength": 1 },
        "source_url": { "type": "string", "format": "uri" },
        "client_build": { "type": "string", "pattern": "^1\\.60\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "foreverDestination": {
      "$ref": "#/$defs/foreverEvidence",
      "required": ["map_id", "x", "y", "kind", "entity_id"],
      "properties": {
        "map_id": { "type": "integer", "minimum": 1 },
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "kind": { "enum": ["quest_start", "quest_end", "objective", "vendor", "trainer", "entrance", "spawn"] },
        "entity_id": { "type": "integer", "minimum": 1 },
        "name": { "type": "string" }
      }
    },
    "foreverQuestStep": {
      "$ref": "#/$defs/foreverEvidence",
      "required": ["quest_id", "name", "kind"],
      "properties": {
        "quest_id": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["prerequisite", "alternative", "reward"] },
        "start": { "$ref": "#/$defs/foreverDestination" },
        "finish": { "$ref": "#/$defs/foreverDestination" }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "type",
        "confidence"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "drop",
            "quest",
            "vendor",
            "crafted",
            "pvp",
            "token_turnin",
            "world_drop",
            "unknown"
          ]
        },
        "entity_id": {
          "type": "integer"
        },
        "entity_name": {
          "type": "string"
        },
        "zone": {
          "type": "string"
        },
        "activity_zones": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "difficulty": {
          "type": "string"
        },
        "drop_percent": {
          "type": "number"
        },
        "count": {
          "type": "integer"
        },
        "out_of": {
          "type": "integer"
        },
        "quest_id": {
          "type": "integer"
        },
        "quest_steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/foreverQuestStep" }
        },
        "destination": { "$ref": "#/$defs/foreverDestination" },
        "vendor_id": {
          "type": "integer"
        },
        "profession": {
          "type": "string"
        },
        "side": {
          "type": "string"
        },
        "eligibility": {
          "type": "object",
          "required": ["min_level"],
          "properties": {
            "min_level": { "type": "integer", "minimum": 1, "maximum": 60 },
            "max_level": { "type": "integer", "minimum": 1, "maximum": 60 },
            "classes": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
            "races": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "source_url": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["evidence_id", "content_digest"],
            "properties": {
              "evidence_id": { "type": "string", "minLength": 1 },
              "content_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        },
        "attribution": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["credit", "licence", "licenceUrl", "source"],
            "properties": {
              "credit": { "type": "string", "minLength": 1 },
              "licence": { "type": "string", "minLength": 1 },
              "licenceUrl": { "type": "string", "format": "uri" },
              "source": { "type": "string", "format": "uri" }
            }
          }
        },
        "confidence": {
          "type": "string"
        },
        "world_drop": {
          "type": "boolean"
        },
        "token_sources": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/source"
              },
              {
                "type": "object",
                "required": [
                  "token_item_id",
                  "token_name",
                  "token_count"
                ],
                "properties": {
                  "token_item_id": {
                    "type": "integer"
                  },
                  "token_name": {
                    "type": "string"
                  },
                  "token_count": {
                    "type": "integer"
                  },
                  "token_source_url": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        "quest_starter_sources": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/source"
              },
              {
                "type": "object",
                "required": [
                  "quest_starter_item_id",
                  "quest_starter_name",
                  "quest_starter_relationship",
                  "quest_starter_source_url"
                ],
                "properties": {
                  "quest_starter_item_id": {
                    "type": "integer"
                  },
                  "quest_starter_name": {
                    "type": "string"
                  },
                  "quest_starter_relationship": {
                    "type": "string",
                    "enum": [
                      "direct_starter",
                      "quest_chain_gate"
                    ]
                  },
                  "quest_starter_source_url": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        "costs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "amount",
              "name"
            ],
            "properties": {
              "amount": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "currency_id": {
                "type": "integer"
              },
              "item_id": {
                "type": "integer"
              }
            }
          }
        },
        "available_from_phase": {
          "type": "string",
          "enum": [
            "PR",
            "T4",
            "T5",
            "T6",
            "ZA",
            "SWP"
          ]
        },
        "available_until_phase": {
          "type": "string",
          "enum": [
            "PR",
            "T4",
            "T5",
            "T6",
            "ZA",
            "SWP"
          ]
        },
        "tradeable": {
          "type": "boolean"
        }
      }
    }
  }
}
