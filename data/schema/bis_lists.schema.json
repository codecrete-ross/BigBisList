{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Big BiS List BiS lists",
  "type": "object",
  "required": [
    "coverage",
    "lists"
  ],
  "properties": {
    "coverage": {
      "type": "string"
    },
    "lists": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "class",
          "spec",
          "phase",
          "slot",
          "items",
          "source_url"
        ],
        "properties": {
          "class": {
            "type": "string"
          },
          "spec": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "slot": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "item_id",
                "rank_label",
                "rank_group",
                "context"
              ],
              "properties": {
                "item_id": {
                  "type": "integer"
                },
                "rank": {
                  "type": "integer"
                },
                "rank_label": {
                  "type": "string"
                },
                "rank_group": {
                  "type": "string"
                },
                "context": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                },
                "guide_evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["table_id", "guide_phase", "original_rating", "conditions", "source_url"],
                    "properties": {
                      "table_id": {"type": "string", "pattern": "^guide:[a-f0-9]{24}$"},
                      "guide_phase": {"enum": ["PR", "T4", "T5", "T6", "ZA", "SWP"]},
                      "rating_phase": {"enum": ["PR", "T4", "T5", "T6", "ZA", "SWP"]},
                      "content_phase": {"enum": ["PR", "T4", "T5", "T6", "ZA", "SWP"]},
                      "original_rating": {"type": "string"},
                      "grade": {"type": "integer", "minimum": 1, "maximum": 4},
                      "conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
                      "source_url": {"type": "string"},
                      "table_heading": {"type": "string"}
                    }
                  }
                }
              }
            }
          },
          "content_phase": {
            "type": "string",
            "enum": [
              "PR",
              "T4",
              "T5",
              "T6",
              "ZA",
              "SWP"
            ]
          },
          "inherited_from_phase": {
            "type": "string",
            "enum": [
              "PR",
              "T4",
              "T5",
              "T6",
              "ZA",
              "SWP"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "phase": {
                  "const": "PR"
                }
              }
            },
            "then": {
              "required": [
                "content_phase"
              ]
            }
          }
        ]
      }
    }
  }
}
