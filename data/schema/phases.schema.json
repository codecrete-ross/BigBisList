{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Big BiS List phases",
  "type": "object",
  "required": ["phases"],
  "properties": {
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "name"],
        "properties": {
          "key": { "type": "string" },
          "name": { "type": "string" },
          "starts_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$",
            "description": "Official UTC content-launch timestamp when a phase has a published schedule."
          },
          "starts_at_epoch": {
            "type": "integer",
            "minimum": 0,
            "description": "Unix timestamp equivalent of starts_at, or zero for content available at launch."
          }
        }
      }
    }
  }
}
